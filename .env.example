# KPI Bridge — configuration locale. Aucun secret n'est nécessaire : la session est créée par le lanceur.
# Copiez ce fichier en .env pour modifier une valeur (setup le fait automatiquement).

# Réseau : l'application écoute uniquement sur la boucle locale.
KPI_HOST=127.0.0.1
KPI_PORT=8765

# Données (par défaut ~/.kpi-bridge/data). Le stockage n'est pas chiffré par l'application :
# activez le chiffrement du disque du système (BitLocker, FileVault, LUKS) si nécessaire.
# KPI_DATA_DIR=

# Limites (appliquées pendant le traitement)
KPI_MAX_FILE_MIB=25
KPI_MAX_ROWS=200000
KPI_MAX_COLS=200
KPI_MAX_PDF_PAGES=50
KPI_MAX_OCR_PAGES=20
KPI_JOB_TIMEOUT_S=900
KPI_JOB_MEMORY_MIB=3072

# IA locale (Ollama). Aucune API cloud.
KPI_LLM_PROVIDER=ollama
KPI_OLLAMA_URL=http://127.0.0.1:11434
KPI_OLLAMA_MODEL=qwen3:4b
KPI_OLLAMA_TIMEOUT_S=120
KPI_OLLAMA_NUM_CTX=4096

# Session locale (durée en secondes)
KPI_SESSION_TTL_S=43200
# Uniquement derrière un proxy HTTPS : KPI_SECURE_COOKIES=1

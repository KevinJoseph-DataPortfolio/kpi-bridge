# KPI Bridge: local configuration. No secret is needed: the session is created by the launcher.
# Copy this file to .env to change a value (setup does it automatically).

# Network: the application listens on the loopback interface only.
KPI_HOST=127.0.0.1
KPI_PORT=8765

# Data (default ~/.kpi-bridge/data). Storage is not encrypted by the application:
# enable your operating system's disk encryption (BitLocker, FileVault, LUKS) if needed.
# KPI_DATA_DIR=

# Limits (enforced during processing)
KPI_MAX_FILE_MIB=25
KPI_MAX_ROWS=200000
KPI_MAX_COLS=200
KPI_MAX_PDF_PAGES=50
KPI_MAX_OCR_PAGES=20
KPI_JOB_TIMEOUT_S=900
KPI_JOB_MEMORY_MIB=3072

# Local AI (Ollama). No cloud API.
KPI_LLM_PROVIDER=ollama
KPI_OLLAMA_URL=http://127.0.0.1:11434
KPI_OLLAMA_MODEL=qwen3:4b
KPI_OLLAMA_TIMEOUT_S=120
KPI_OLLAMA_NUM_CTX=4096

# Local session (duration in seconds)
KPI_SESSION_TTL_S=43200
# Only behind an HTTPS proxy: KPI_SECURE_COOKIES=1
